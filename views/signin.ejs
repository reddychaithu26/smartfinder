<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">
    <h2>Welcome Back</h2>
    <p class="auth-sub">Sign in to your SmartFinder account</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="demo-hint">
      <strong>Demo account:</strong> Roll: <code>23881A05GM</code> &nbsp;|&nbsp; Password: <code>demo123</code>
    </div>

    <form method="POST" action="/signin">
      <div class="form-group">
        <label for="roll">Roll Number</label>
        <input type="text" id="roll" name="roll" placeholder="23881A05GM" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Your password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-full" style="margin-top:.5rem">Sign In</button>
    </form>

    <p class="auth-switch">New here? <a href="/signup">Create account</a></p>
  </div>
</div>

<%- include('partials/footer') %>
