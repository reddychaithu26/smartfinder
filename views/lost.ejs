<%- include('partials/header') %>

<div class="page-inner">
  <div class="page-header">
    <div class="page-title-row">
      <div class="page-title-icon">🔴</div>
      <h2>Lost Items</h2>
    </div>
  </div>

  <% if (items.length === 0) { %>
    <div class="empty">
      <div class="empty-icon">🎉</div>
      <h3>No lost items</h3>
      <p>Great news — nothing is reported lost right now!</p>
    </div>
  <% } else { %>
    <div class="items-grid">
      <% items.forEach(item => { %>
        <div class="item-card">
          <div class="item-top">
            <div>
              <div class="item-name"><%= item.name %></div>
              <div class="item-desc"><%= item.desc %></div>
              <div class="item-meta">Reported by <%= item.reporterName %> · <%= item.date %></div>
            </div>
            <span class="badge badge-lost">⚠ Lost</span>
          </div>

          <% if (item.images && item.images.length) { %>
            <div class="item-imgs">
              <% item.images.forEach(img => { %>
                <img src="<%= img %>" alt="item photo" class="item-img">
              <% }) %>
            </div>
          <% } %>

          <% if (item.reporterRoll === user.roll) { %>
            <div class="item-actions">
              <form method="POST" action="/items/resolve/<%= item.id %>" style="display:inline">
                <button type="submit" class="btn btn-success btn-sm"
                  onclick="return confirm('Mark as resolved?')">✓ Mark Resolved</button>
              </form>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
